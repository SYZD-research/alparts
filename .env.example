# Generate independent high-entropy values; do not commit a populated .env file.
POSTGRES_USER=alparts
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=alparts
DATABASE_URL=postgresql://alparts:replace-with-a-random-database-password@localhost:5433/alparts
BIND_HOST=127.0.0.1
PORT=3000
DB_SSL=false
# Runtime fencing needs at least 2 pooled connections plus 1 dedicated session.
# PostgreSQL session advisory locks require direct/session-pooled connections.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
# Production may set both dependency TLS flags false only when both endpoints
# are loopback and this explicit single-host acknowledgement is true.
ALLOW_INSECURE_LOOPBACK_DEPENDENCIES=false

MINIO_ROOT_USER=replace-with-a-random-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
# Provision this separate least-privilege application user in MinIO.
MINIO_ACCESS_KEY=replace-with-a-dedicated-app-user
MINIO_SECRET_KEY=replace-with-a-distinct-random-app-password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=alparts
MINIO_REQUEST_TIMEOUT_MS=10000
# User quota applies separately in each workspace.
STORAGE_QUOTA_BYTES_PER_USER=5368709120
STORAGE_QUOTA_BYTES_PER_CHANNEL=21474836480
STORAGE_QUOTA_BYTES_PER_WORKSPACE=107374182400

PASSWORD_PEPPER=use-an-independent-secret-of-at-least-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
AUDIT_INTEGRITY_KEY=use-a-different-value-of-at-least-32-random-bytes
# Optional independent offline witness. See docs/security/AUDIT_ALPARTS_REMEDIATION.md.
# Never copy the witness signing private key onto the runtime host.
# AUDIT_WITNESS_REQUIRED=true
# AUDIT_WITNESS_PUBLIC_KEY_FILE=/run/secrets/audit_witness_public_key
# AUDIT_WITNESS_PATH=/run/secrets/audit_witness
# AUDIT_WITNESS_DEPLOYMENT_ID=deployment-uuid
# Mount this path from storage protected independently from PostgreSQL. Set
# Runtime requires a provisioned checkpoint in every environment.
AUDIT_CHECKPOINT_PATH=/var/lib/alparts-audit/checkpoint.json
AUDIT_CHECKPOINT_REQUIRED=true
# Initial bootstrap only: this creates the deployment's first account. After
# that, registration requires a one-time workspace invitation issued via API.
REGISTRATION_INVITE_SECRET=replace-with-a-high-entropy-bootstrap-secret
# Passkeys: the RP ID is a hostname, without a scheme or port. Keep it stable.
# Defaults use the first CORS origin. Set explicit HTTPS origins in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
# Leave empty when connecting directly. In production, list only the exact
# reverse-proxy addresses/CIDRs whose Forwarded/X-Forwarded-* data is trusted.
TRUSTED_PROXIES=

# Disabled by default. When enabled, /metrics requires this independent bearer
# token (or METRICS_TOKEN_FILE) and should remain on a private monitoring path.
METRICS_ENABLED=false
METRICS_TOKEN=

# WebRTC voice uses no third-party relay by default. For internet/NAT use,
# configure only operator-controlled STUN/TURN endpoints. TURN credentials are
# necessarily disclosed to authenticated call participants; prefer short-lived
# credentials issued by the TURN deployment.
VOICE_ICE_SERVERS_JSON=[]

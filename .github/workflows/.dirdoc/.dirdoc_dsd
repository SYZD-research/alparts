{
  "format": "dirdoc/dsd",
  "version": 1,
  "summary": "GitHub Actions のワークフロー。品質・セキュリティ検査、成果物のビルド、サポート終了の通知、AI メンテナンスとレビュー",
  "tree": {
    "name": ".",
    "type": "dir",
    "children": [
      {
        "name": "ai-review.yml",
        "type": "file",
        "dsd": "ai",
        "note": "メンションによる PR の AI レビュー"
      },
      {
        "name": "android.yml",
        "type": "file",
        "dsd": "build",
        "note": "Android のビルドと来歴証明"
      },
      {
        "name": "ci.yml",
        "type": "file",
        "dsd": "checks",
        "note": "品質、履歴の秘密、結合テスト、サプライチェーン"
      },
      {
        "name": "codeql.yml",
        "type": "file",
        "dsd": "checks",
        "note": "CodeQL"
      },
      {
        "name": "desktop.yml",
        "type": "file",
        "dsd": "build",
        "note": "デスクトップ版のビルド"
      },
      {
        "name": "end-of-support.yml",
        "type": "file",
        "dsd": "ai",
        "note": "サポート終了の週次検査"
      },
      {
        "name": "maintenance-deps.yml",
        "type": "file",
        "dsd": "ai",
        "note": "依存更新のまとめと仕上げ"
      },
      {
        "name": "maintenance-docs.yml",
        "type": "file",
        "dsd": "ai",
        "note": "dirdoc の説明の週次更新"
      },
      {
        "name": "maintenance-issues.yml",
        "type": "file",
        "dsd": "ai",
        "note": "ai-fix の issue の修正"
      }
    ]
  },
  "dsd": [
    {
      "id": "checks",
      "name": "検査",
      "document": "[[/.github/workflows/ci.yml]] は PR と master で、品質検査、履歴の秘密検査、結合テスト、イメージのサプライチェーン検査を並行して行う。補助スクリプトは [[/scripts/]] にある。[[/.github/workflows/codeql.yml]] は CodeQL の指摘が 1 件でもあれば失敗する。例外は、レビューで受け入れて [[/scripts/ci/codeql-accepted.mjs]] に理由とともに挙げた経路だけ。ワークフローの権限は既定で読み取りのみで、アクションはコミット SHA で固定している。"
    },
    {
      "id": "build",
      "name": "成果物のビルド",
      "document": "[[/.github/workflows/android.yml]] と [[/.github/workflows/desktop.yml]] は、関連ファイルの変更を含む PR でビルド確認だけを行い、手動実行のときだけ未署名の成果物を保存する。配布用のビルドには、リポジトリ変数 `ALPARTS_TRANSPORT_PINS_JSON` の通信ピンが必要で、PR ではダミーの乱数ピンで代用する（接続できない成果物になる）。Android は別ジョブで来歴を証明する。署名はここでは行わない（[[/scripts/release/]]）。"
    },
    {
      "id": "ai",
      "name": "自動メンテナンスと通知",
      "document": "[[/.github/workflows/end-of-support.yml]] はサポート終了の依存を issue にまとめ、[[/.github/workflows/maintenance-deps.yml]] はその issue と Dependabot の PR を AI で仕上げ、[[/.github/workflows/maintenance-issues.yml]] は `ai-fix` ラベルの issue を修正し、[[/.github/workflows/maintenance-docs.yml]] はコードに追いついていない dirdoc の説明を更新し、[[/.github/workflows/ai-review.yml]] は PR のレビューを行う。依存更新と issue 修正でも、変更したコードの dirdoc の説明をエージェントが更新し、検証で `dirdoc check` を通す。いずれも段階ごとにジョブと権限を分け、OpenRouter の鍵を持つのはモデルを呼ぶステップだけで、書込み権限を持つ公開ジョブは変更内のコードを実行しない。設計の詳細は [[/scripts/maintenance/#design]]。"
    }
  ]
}

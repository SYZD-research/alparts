<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp">
        <!-- A separate card is needed to center and cap its width inside the scrollable viewport. -->
        <LinearLayout
            android:id="@+id/setup_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/setup_card" android:elevation="8dp"
            android:orientation="vertical" android:padding="24dp" tools:ignore="UselessParent">
            <ImageView
                android:layout_width="64dp" android:layout_height="64dp"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp"
                android:src="@drawable/alparts_logo" android:importantForAccessibility="no"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/setup_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityHeading="true" android:gravity="center"
                android:text="@string/connection_title" android:textColor="@android:color/white"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/setup_description"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center"
                android:text="@string/connection_description" android:textColor="@color/alparts_muted"
                android:textSize="14sp" android:lineSpacingExtra="4dp" />
            <LinearLayout
                android:id="@+id/connection_fields"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:labelFor="@id/server_address" android:text="@string/connection_label"
                    android:textColor="@color/alparts_text" android:textSize="12sp" android:textStyle="bold" />
                <!-- The label names the field; the hint supplies an example address. -->
                <EditText
                    android:id="@+id/server_address"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:minHeight="48dp"
                    android:background="@drawable/setup_input" android:backgroundTint="@null"
                    android:padding="12dp" android:hint="@string/connection_hint"
                    android:inputType="textUri" android:singleLine="true" android:imeOptions="actionGo"
                    android:importantForAutofill="no" android:saveEnabled="false"
                    android:maxLength="2048" android:textColor="@color/alparts_text"
                    android:textColorHint="@color/alparts_muted" android:textSize="16sp"
                    tools:ignore="LabelFor" />
            </LinearLayout>
            <TextView
                android:id="@+id/setup_error"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"
                android:textColor="@color/alparts_error" android:textSize="14sp"
                android:visibility="gone" />
            <Button
                android:id="@+id/setup_action"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:minHeight="48dp"
                android:background="@drawable/setup_button" android:backgroundTint="@null"
                android:padding="12dp" android:text="@string/connect"
                android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/alparts_accent_pressed" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/alparts_accent" />
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="@color/alparts_text" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/alparts_accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>

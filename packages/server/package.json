{
  "name": "@alparts/server",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "RUN_INTEGRATION=1 tsx --test --test-concurrency=1 src/security/audit-checkpoint-write-failure.integration.test.ts src/security/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/scripts/migrate-runtime.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:fingerprint": "tsx src/scripts/database-fingerprint.ts",
    "audit:checkpoint:init": "tsx src/scripts/initialize-audit-checkpoint.ts",
    "audit:checkpoint:init:runtime": "node dist/scripts/initialize-audit-checkpoint.js"
  },
  "dependencies": {
    "@alparts/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@alparts/server",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:formal-conformance": "RUN_FORMAL_CONFORMANCE=1 tsx ../../formal-model/conformance/service-audit.mts",
    "test:integration": "RUN_INTEGRATION=1 tsx --test --test-concurrency=1 src/security/audit-checkpoint-write-failure.integration.test.ts src/security/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/scripts/migrate-runtime.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:fingerprint": "tsx src/scripts/database-fingerprint.ts",
    "audit:head:init": "tsx src/scripts/initialize-audit-head.ts",
    "audit:head:init:runtime": "node dist/scripts/initialize-audit-head.js",
    "audit:checkpoint:init": "tsx src/scripts/initialize-audit-checkpoint.ts",
    "audit:checkpoint:init:runtime": "node dist/scripts/initialize-audit-checkpoint.js",
    "audit:witness": "node dist/scripts/audit-witness.js",
    "test:account-security": "RUN_ACCOUNT_SECURITY_INTEGRATION=1 tsx --test src/security/account-security.integration.test.ts src/security/password-migration.integration.test.ts"
  },
  "dependencies": {
    "@alparts/shared": "workspace:*",
    "@simplewebauthn/server": "14.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8",
    "ts-mls": "1.6.4",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

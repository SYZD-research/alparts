{
  "name": "@alparts/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "alparts maintainers",
  "homepage": "https://github.com/SYZD-research/alparts",
  "repository": {
    "type": "git",
    "url": "https://github.com/SYZD-research/alparts.git"
  },
  "desktopName": "alparts.desktop",
  "type": "module",
  "main": "dist/main.js",
  "description": "alparts desktop client for Windows, macOS, and Linux",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-transport-pins.mjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:renderer": "pnpm --filter @alparts/shared run build && pnpm --filter @alparts/client run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "start": "pnpm run build:renderer && pnpm run build && electron .",
    "pack": "pnpm run build:renderer && pnpm run build && electron-builder --dir --publish never",
    "dist": "pnpm run build:renderer && pnpm run build && electron-builder --publish never",
    "dist:windows": "pnpm run build:renderer && pnpm run build && electron-builder --win --publish never",
    "dist:macos": "pnpm run build:renderer && pnpm run build && electron-builder --mac --publish never",
    "dist:linux": "pnpm run build:renderer && pnpm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "26.0.0",
    "electron": "44.1.0",
    "electron-builder": "26.15.7",
    "esbuild": "0.28.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "org.alparts.desktop",
    "productName": "alparts",
    "extraMetadata": {
      "name": "alparts"
    },
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ja"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main.js",
      "dist/file-save.js",
      "dist/security-policy.js",
      "dist/transport-pins.js",
      "dist/transport-pins.json",
      "dist/settings.js",
      "dist/vault.js",
      "dist/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "desktop-icon.png"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "executableName": "alparts",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "音声チャンネルで通話するためにマイクを使用します。"
      }
    },
    "win": {
      "executableName": "alparts",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "executableName": "alparts",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Network",
      "syncDesktopName": true,
      "maintainer": "alparts maintainers",
      "synopsis": "Secure workspace communication"
    }
  }
}

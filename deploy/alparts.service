[Unit]
Description=alparts Phase 1 secure communication server
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/alparts
Environment=NODE_ENV=production
EnvironmentFile=-/etc/alparts/alparts.env
Environment=BIND_HOST=127.0.0.1
LoadCredential=database_url:/etc/alparts/credentials/database_url
LoadCredential=s3_access_key:/etc/alparts/credentials/s3_access_key
LoadCredential=s3_secret_key:/etc/alparts/credentials/s3_secret_key
LoadCredential=jwt_secret:/etc/alparts/credentials/jwt_secret
LoadCredential=password_pepper:/etc/alparts/credentials/password_pepper
LoadCredential=audit_integrity_key:/etc/alparts/credentials/audit_integrity_key
Environment=DATABASE_URL_FILE=%d/database_url
Environment=S3_ACCESS_KEY_FILE=%d/s3_access_key
Environment=S3_SECRET_KEY_FILE=%d/s3_secret_key
Environment=JWT_SECRET_FILE=%d/jwt_secret
Environment=PASSWORD_PEPPER_FILE=%d/password_pepper
Environment=AUDIT_INTEGRITY_KEY_FILE=%d/audit_integrity_key
Environment=AUDIT_CHECKPOINT_PATH=/var/lib/alparts-audit/checkpoint.json
Environment=AUDIT_CHECKPOINT_REQUIRED=true
# Set AUDIT_HEAD_BUCKET and stable AUDIT_HEAD_OBJECT_KEY in /etc/alparts/alparts.env.
# Registration codes: set SMTP_HOST, SMTP_PORT, SMTP_FROM (and SMTP_USER) there
# too, and keep the SMTP password in a credential:
#LoadCredential=smtp_password:/etc/alparts/credentials/smtp_password
#Environment=SMTP_PASSWORD_FILE=%d/smtp_password
# Provision/upgrade while stopped; do not restore this bucket with the DB.
Environment=ALLOW_INSECURE_LOOPBACK_DEPENDENCIES=true
ExecStart=/usr/bin/node --permission --allow-fs-read=/opt/alparts --allow-fs-read=%d --allow-fs-read=/var/lib/alparts-audit --allow-fs-write=/var/lib/alparts-audit --allow-worker --disallow-code-generation-from-strings /opt/alparts/packages/server/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
OOMPolicy=stop
MemoryMax=1G
TasksMax=256
LimitNOFILE=65536

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# This unit uses a local reverse proxy, PostgreSQL and object storage. Remote
# dependencies require explicit addresses in an operator-managed drop-in.
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
StateDirectory=alparts-audit
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target

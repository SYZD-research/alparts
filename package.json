{
  "name": "alparts",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.21.0"
  },
  "description": "Secure communications platform",
  "scripts": {
    "build:shared": "pnpm --filter @alparts/shared run build",
    "dev": "pnpm run build:shared && pnpm -r --parallel run dev",
    "dev:server": "pnpm run build:shared && pnpm --filter @alparts/server run dev",
    "dev:client": "pnpm run build:shared && pnpm --filter @alparts/client run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run build:shared && pnpm -r --if-present run test",
    "test:backup-security": "bash scripts/tests/backup-security.test.sh",
    "lint": "oxlint --deny-warnings packages",
    "security:secrets": "bash scripts/check-secrets.sh"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "oxlint": "1.80.0",
    "secretlint": "13.0.5"
  }
}
